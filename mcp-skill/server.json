{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fenix19830717a-sudo/aibond",
  "description": "aibond 企业级人机协同平台 - 多Agent协作、MCP组网、Workflow编排、Parliament议会决策",
  "repository": {
    "url": "https://github.com/fenix19830717a-sudo/aibond",
    "source": "github"
  },
  "version": "1.3.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "aibond-mcp",
      "version": "1.3.0",
      "transport": {
        "type": "streamable-http",
        "url": "https://aib2b.bond/api/mcp/sse"
      },
      "environmentVariables": [
        {
          "description": "aibond 平台 API Key（用于认证）",
          "isRequired": false,
          "format": "string",
          "isSecret": true,
          "name": "AIBOND_API_KEY"
        }
      ]
    }
  ]
}