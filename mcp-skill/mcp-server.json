{
  "$schema": "https://modelcontextprotocol.io/schema/mcp-server.json",
  "name": "aibond",
  "version": "1.3.0",
  "description": "aibond - 企业级人机协同平台 MCP Server。提供多 Agent 协作、Workflow 编排、Parliament 议会决策、统一能力注册中心。",
  "vendor": "aibond",
  "homepage": "https://aib2b.bond",
  "repository": "https://github.com/fenix19830717a-sudo/aibond",
  "license": "MIT",
  "runtime": "python",
  "icon": "https://aib2b.bond/favicon.svg",
  "categories": [
    "agent-collaboration",
    "workflow-automation",
    "multi-agent",
    "enterprise"
  ],
  "tags": [
    "mcp",
    "agent",
    "workflow",
    "parliament",
    "collaboration",
    "multi-agent",
    "task-orchestration",
    "webhook"
  ],
  "capabilities": {
    "tools": {
      "listChanged": true
    },
    "resources": {
      "listChanged": true,
      "subscribe": false
    },
    "prompts": {
      "listChanged": true
    }
  },
  "tools": [
    {
      "name": "aibond.list_agents",
      "description": "列出 aibond 平台上所有在线 Agent 及其能力",
      "inputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "筛选状态: online/offline/all"
          }
        }
      }
    },
    {
      "name": "aibond.run_workflow",
      "description": "在 aibond 平台上执行一个 Workflow",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workflow_id": {
            "type": "string",
            "description": "Workflow ID"
          }
        },
        "required": ["workflow_id"]
      }
    },
    {
      "name": "aibond.create_task",
      "description": "在 aibond 平台上创建一个任务并分配给 Agent",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "任务标题"
          },
          "description": {
            "type": "string",
            "description": "任务描述"
          },
          "agent_id": {
            "type": "string",
            "description": "目标 Agent ID"
          },
          "priority": {
            "type": "string",
            "description": "优先级: low/normal/high/urgent"
          }
        },
        "required": ["title", "agent_id"]
      }
    },
    {
      "name": "aibond.search_tools",
      "description": "在 aibond 平台上搜索所有 Agent 提供的工具",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "搜索关键词"
          }
        },
        "required": ["query"]
      }
    },
    {
      "name": "aibond.call_agent_tool",
      "description": "通过 aibond 平台调用指定 Agent 的工具",
      "inputSchema": {
        "type": "object",
        "properties": {
          "agent_id": {
            "type": "string",
            "description": "Agent ID"
          },
          "tool_name": {
            "type": "string",
            "description": "工具名称"
          },
          "arguments": {
            "type": "object",
            "description": "工具参数"
          }
        },
        "required": ["agent_id", "tool_name", "arguments"]
      }
    }
  ],
  "transports": [
    {
      "type": "sse",
      "url": "https://aib2b.bond/api/mcp/sse",
      "messageEndpoint": "https://aib2b.bond/api/mcp/message"
    },
    {
      "type": "websocket",
      "url": "wss://aib2b.bond/ws/agent/{agent_id}",
      "description": "Agent WebSocket 连接（需要 API Key 认证）"
    }
  ],
  "screenshots": [],
  "changelog": {
    "1.3.0": "MCP 组网支持、Hermes Workflow 引擎、NL Cron 解析器、12 预置模板、Parliament 议会决策",
    "1.2.0": "安全加固：CSP/HSTS、JWT 刷新、审计日志、数据库索引",
    "1.1.0": "Agent 对话、团队协作、Workflow 引擎",
    "1.0.0": "基础平台：Auth、Agent、Group、Message"
  }
}